---
const route = Astro.locals.starlightRoute;
const id = route.entry.id;

const labels = new Map([
	["getting-started", "Guide"],
	["examples", "Guide"],
	["protocol", "Protocol"],
	["limits", "Protocol"],
	["development", "Contribute"],
]);
// biome-ignore lint/correctness/noUnusedVariables: Referenced by the Astro template.
const label =
	id === "api" || id.startsWith("api/")
		? "API reference"
		: (labels.get(id) ?? "Reference");
---

<div class="manual-page-title">
	<p>{label}</p>
	<h1 id="_top">{route.entry.data.title}</h1>
</div>

<style>
	.manual-page-title {
		padding-top: clamp(2rem, 5vw, 4.5rem);
	}

	p {
		margin: 0 0 0.9rem;
		color: var(--gc-muted);
		font-family: var(--gc-font-mono);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}

	h1 {
		max-width: 18ch;
		margin: 0;
		color: var(--gc-ink);
		font-family: var(--gc-font-serif);
		font-size: var(--sl-text-h1);
		font-weight: 600;
		letter-spacing: -0.035em;
		line-height: 1;
		overflow-wrap: anywhere;
	}
</style>
