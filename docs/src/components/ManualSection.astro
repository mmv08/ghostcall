---
interface Props {
	index: string;
	title: string;
	id: string;
}

// biome-ignore lint/correctness/noUnusedVariables: Referenced by the Astro template.
const { index, title, id } = Astro.props;
// biome-ignore lint/correctness/noUnusedVariables: Referenced by the Astro template.
const headingId = `${id}-title`;
---

<section class="manual-section" id={id} aria-labelledby={headingId}>
	<div class="manual-section-label not-content">
		<h2 id={headingId}>
			<span>§{index}</span>
			<span>{title}</span>
		</h2>
	</div>
	<div class="manual-section-body">
		<slot />
	</div>
</section>

<style>
	.manual-section {
		display: grid;
		grid-template-columns:
			minmax(0, var(--gc-label-column))
			minmax(0, 1fr);
		gap: var(--gc-column-gap);
		padding-block: 2.25rem;
		border-top: 1px solid var(--gc-rule);
		scroll-margin-top: calc(var(--sl-nav-height) + 1.5rem);
	}

	.manual-section-label {
		min-width: 0;
		/* Sits the label's cap-line on the first cap-line of the body text. */
		padding-top: 0.4rem;
	}

	h2 {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		margin: 0;
		padding: 0;
		border: 0;
		color: var(--gc-muted);
		font-family: var(--gc-font-mono);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.09em;
		line-height: 1.45;
		text-transform: uppercase;
	}

	.manual-section-body {
		min-width: 0;
		margin-top: 0;
	}

	.manual-section-body > :global(p + p:not(.manual-follow-link)) {
		margin-top: 0.85rem;
	}

	.manual-section-body > :global(* + .expressive-code) {
		margin-top: 1.15rem;
	}

	.manual-section-body > :global(.manual-follow-link) {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
		margin-top: 1.25rem;
	}

	.manual-section-body > :global(.manual-follow-link a) {
		border-bottom: 1px solid var(--gc-ink);
		padding-bottom: 0.2rem;
		color: var(--gc-ink);
		font-family: var(--gc-font-mono);
		font-size: 0.74rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.manual-section-body > :global(.manual-follow-link a:is(:hover, :focus-visible)) {
		border-color: var(--gc-accent);
		color: var(--gc-accent);
	}

	@media screen and (max-width: 47.99rem) {
		.manual-section {
			grid-template-columns: minmax(0, 1fr);
			gap: 1.1rem;
		}

		.manual-section-label {
			padding-top: 0;
		}

		h2 {
			flex-direction: row;
			gap: 0.75rem;
		}
	}
</style>
